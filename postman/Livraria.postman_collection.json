    {
      "name": "Opcional — Cadastro na página de login (use e-mail novo)",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/cadastro",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Novo leitor\",\n  \"email\": \"novo-leitor-{{$timestamp}}@exemplo.com\",\n  \"senha\": \"Senha de exemplo!123\"\n}"
        }
