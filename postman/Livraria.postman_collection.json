    {
      "name": "20 — Excluir livro criado",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/livros/{{livroId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 204\", () => pm.response.to.have.status(204));",
              "pm.test(\"Resposta sem corpo\",()=>pm.expect(pm.response.text()).to.equal(\"\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "21 — Confirmar livro inexistente",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/livros/{{livroId}}"
      },
