            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/livros",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"\",\n  \"autor\": \"Autor de exemplo\",\n  \"isbn\": null,\n  \"anoPublicacao\": 2020,\n  \"generoId\": {{generoId}}\n}",
          "options": {
