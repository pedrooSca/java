          }
        }
      ]
    },
    {
      "name": "10 — Atualizar livro",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/livros/{{livroId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Livro Postman atualizado\",\n  \"autor\": \"Autor de exemplo\",\n  \"isbn\": null,\n  \"anoPublicacao\": 2020,\n  \"generoId\": {{generoId}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 — Avaliar livro",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/avaliacoes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuarioId\": {{usuarioId}},\n  \"livroId\": {{livroId}},\n  \"nota\": 5,\n  \"comentario\": \"Excelente leitura.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
